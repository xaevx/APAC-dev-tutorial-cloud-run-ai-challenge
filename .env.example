# Server Configuration
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Google Cloud & Secret Manager
# In Cloud Run production set USE_SECRET_MANAGER=true and set GCP_PROJECT_ID
USE_SECRET_MANAGER=false
GCP_PROJECT_ID=your-gcp-project-id

# Gemini API Key (Used locally when USE_SECRET_MANAGER=false)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Credentials (Optional for local dev emulator, required for production)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account JSON file (optional if using standard GCP ADC)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Frontend Firebase Client Config (Public keys safe for browser bundle)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
